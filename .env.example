DB_PASSWORD=app_dev_password
JWT_SECRET=replace-with-a-long-random-secret
# AI provider: OpenRouter is used when OPENROUTER_API_KEY is set (OPENROUTER_MODEL required, e.g. a tool-calling model slug).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Fallback: Anthropic directly
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
SEED_ON_START=true
SEED_PASSWORD=Passw0rd!
